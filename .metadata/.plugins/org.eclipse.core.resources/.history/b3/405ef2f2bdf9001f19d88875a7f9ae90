/**
 * @brief
 * This function is primary called at the beginning of the i2c slave reception with the correct slave address.
 * It will check whether the direction of the i2c slave is a read or a write command and receives the first frame.
 * @param hi2c
 * @param TransferDirection
 * @param AddrMatchCode
 */
void HAL_I2C_AddrCallback(I2C_HandleTypeDef *hi2c, uint8_t TransferDirection, uint16_t AddrMatchCode)
{
	if (TransferDirection == I2C_DIRECTION_TRANSMIT)
	{
		rxcount = 0;
		HAL_I2C_Slave_Seq_Receive_IT(hi2c, RxData, 1, I2C_FIRST_FRAME);
	}
	else
	{
		txcount = 0;
//		dataReg = checkout_reg(DEV_QSFP, current_bank, current_page, current_register);
		HAL_I2C_Slave_Seq_Transmit_IT(hi2c, &dataReg, 1, I2C_FIRST_FRAME);
		current_register++;
	}
}

/**
 * @brief
 * The Tx callback function is called once the slave is sending data to the master.
 * @param hi2c
 */
void HAL_I2C_SlaveTxCpltCallback(I2C_HandleTypeDef *hi2c)
{
	txcount++;
//	dataReg = checkout_reg(DEV_QSFP, current_bank, current_page, current_register);
	HAL_I2C_Slave_Seq_Transmit_IT(hi2c, &dataReg, 1, I2C_NEXT_FRAME);
	current_register++;
}

/**
 * @brief
 * The Rx callback function handles each byte received on the i2c1 slave bus from the master
 * @param hi2c
 */
void HAL_I2C_SlaveRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
	incoming = RxData[rxcount];
	uint16_t code = 0;
	if (rxcount == 1)
	{
		code = (RxData[1] << 8) | RxData[0];
	}
	if (code == 0xABCD)
	{
		rxcount = -1;
	}
	if (chunck_counter == 0 && rxcount == 0 && !chunck_size_flag)
	{
		/* Unlock the Flash to enable the flash control register access *************/
		HAL_FLASH_Unlock();
		/* Allow Access to option bytes sector */
		HAL_FLASH_OB_Unlock();
		/* Fill EraseInit structure*/
		FLASH_EraseInitTypeDef EraseInitStruct;

        EraseInitStruct.TypeErase = FLASH_TYPEERASE_PAGES;
        EraseInitStruct.Page = 0;
        EraseInitStruct.Banks = FLASH_BANK_2;
        EraseInitStruct.NbPages = 127;///pages;
        uint32_t PageError;
        volatile HAL_StatusTypeDef status;
        status = HAL_FLASHEx_Erase(&EraseInitStruct, &PageError);
        HAL_FLASH_OB_Lock();
		HAL_FLASH_Lock();
	}
	if (rxcount == 1 && !chunck_size_flag)
	{
		chunck_size = (RxData[1] << 8) | RxData[0];
		chunck_size_flag = 1;
		rxcount = -1;
	}
	else
	{

	}

    rxcount++;
	if ((rxcount == RxSIZE-1) || (rxcount == 1 && !chunck_size_flag))
	{
		HAL_I2C_Slave_Seq_Receive_IT(hi2c, RxData+rxcount, 1, I2C_LAST_FRAME);
	}
	else
	{
		HAL_I2C_Slave_Seq_Receive_IT(hi2c, RxData+rxcount, 1, I2C_NEXT_FRAME);
	}

 	if (rxcount == RxSIZE)
	{
 		chunck_counter++;
 		volatile uint32_t data_to_FLASH[(sizeof(RxData)/4)	+ (int)((sizeof(RxData) % 4) != 0)];
 		memset((uint8_t*)data_to_FLASH, 0, sizeof(data_to_FLASH));
 		memcpy((uint8_t*)data_to_FLASH, (uint8_t*)RxData, 112);		//128 is the size of chunck
 		volatile uint32_t data_length = (sizeof(data_to_FLASH) / 128)		// 128 bytes size
 											+ (int)((sizeof(data_to_FLASH) % 128) != 0);

 		/* Unlock the Flash to enable the flash control register access *************/
 	    HAL_FLASH_Unlock();

 		/* Allow Access to option bytes sector */
 		HAL_FLASH_OB_Unlock();

 		volatile uint32_t write_cnt= 0 + (128*(chunck_counter-1)), index=0;

 		volatile HAL_StatusTypeDef status = HAL_OK;
 		while(index < data_length*32)
 		{
 			if (status == HAL_OK)
 			{
 				status = HAL_FLASH_Program(FLASH_TYPEPROGRAM_BURST, FLASH_STORAGE+write_cnt, &data_to_FLASH[index]);
 				if(status == HAL_OK)
 				{
 					write_cnt += 128;
 					index += 32;
 				}
 			}
 		}

 		HAL_FLASH_OB_Lock();
 		HAL_FLASH_Lock();

 		if(chunck_counter == chunck_size)
 		{
 			/* Unlock the Flash to enable the flash control register access *************/
 			HAL_FLASH_Unlock();
 			/* Allow Access to option bytes sector */
 			HAL_FLASH_OB_Unlock();
 			/* Fill EraseInit structure*/
 			FLASH_EraseInitTypeDef EraseInitStruct;
 			EraseInitStruct.TypeErase = FLASH_TYPEERASE_PAGES;
 			EraseInitStruct.Page = 8;
 			EraseInitStruct.Banks = FLASH_BANK_1;
 			EraseInitStruct.NbPages = 120;///pages;
 			uint32_t PageError;
 			volatile HAL_StatusTypeDef status;
 			status = HAL_FLASHEx_Erase(&EraseInitStruct, &PageError);
 			write_cnt = 0;
 			for (int i = 0; i < chunck_counter; i++)
 			{
 				status =  HAL_FLASH_Program(FLASH_TYPEPROGRAM_BURST, FLASH_REAL+write_cnt, FLASH_STORAGE+write_cnt);
 				write_cnt += 128;
 			}
 			HAL_FLASH_OB_Lock();
 			HAL_FLASH_Lock();
 			chunck_counter = 0;
 			chunck_size_flag = 0;
 			go2APP();
 		}
	}
}

/**
 * @brief
 * The error callback function is executed each time the max size of reception is not reached and enable again the listening function of the i2c slave.
 * @param hi2c
 */
void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c)
{
	uint32_t errorcode = HAL_I2C_GetError(hi2c);
	if (errorcode == 4) //AF error
	{
		__HAL_I2C_CLEAR_FLAG(hi2c, I2C_FLAG_AF); //clear AF Flag

		if (txcount == 0) //error is while slave is receiving
		{
			process_data(); /*Is this needed?*/
		}
		else //error while slave is transmitting
		{
			txcount = txcount-1;
		}
	}
	HAL_I2C_EnableListen_IT(hi2c);
}

