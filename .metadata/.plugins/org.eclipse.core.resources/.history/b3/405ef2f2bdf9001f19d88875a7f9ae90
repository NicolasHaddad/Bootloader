#ifdef IAP_DEMO
void go2APP(void)
{
	printf("BOOTLOADER Start\r\n");
	//Check if there is something "installed" in the app FLASH region
	if (((*(uint32_t*) FLASH_REAL) & 0x200C0000) == 0x200C0000)   //0x2FFE000  ... == 0x20000000
	{
		printf("APP Start...\r\n");
		osDelay(100);
		/* Unlock the FLASH control register access */
		HAL_FLASH_Unlock();
		/* Unlocks the option bytes block access */
		HAL_FLASH_OB_Unlock();
		CLEAR_BIT(FLASH->OPTR, FLASH_OPTR_nSWBOOT0);
		CLEAR_BIT(FLASH->OPTR, FLASH_OPTR_nBOOT0);
		FLASH->NSBOOTADD1R = 0x08010000;
		SET_BIT(FLASH->NSCR, FLASH_NSCR_OPTSTRT);
		/* Launch the option byte loading */
		HAL_FLASH_OB_Launch();
		/* Locks the option bytes block access */
		HAL_FLASH_OB_Lock();
		/* Lock the FLASH control register access */
		HAL_FLASH_Lock();
	}
	else
	{
		//there is no application installed
		printf("No APP found!!!\r\n");
	}
}
#endif


void read_flash(uint8_t* data)
{
	volatile uint32_t read_data;
	volatile uint32_t read_cnt=0;
	do
	{
		read_data = *(uint32_t*)(FLASH_STORAGE + read_cnt);
		if(read_data != 0xFFFFFFFF)
		{
			data[read_cnt] = (uint8_t)read_data;
			data[read_cnt + 1] = (uint8_t)(read_data >> 8);
			data[read_cnt + 2] = (uint8_t)(read_data >> 16);
			data[read_cnt + 3] = (uint8_t)(read_data >> 24);
			read_cnt += 4;
		}
	}while(read_data != 0xFFFFFFFF);
}

